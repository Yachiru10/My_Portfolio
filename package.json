{
  "name": "renzo-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio of Renzo Mingan, backend developer. Plain HTML + Tailwind CSS, Node.js API on Vercel, Supabase database.",
  "scripts": {
